# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Snakemake
.snakemake/
snakemake-*.log

# Pipeline outputs (generated; keep the tree out of version control)
output/*
!output/.gitkeep
output-*/

# SLURM job logs (generated)
workflow/slurm/logs/*
!workflow/slurm/logs/.gitkeep

# Large or generated structural / sequence artefacts
*.pdb
*.cif
*.xtc
*.trr
*.tpr
*.gro
*.edr
*.dcd
!resources/*.pdb

# Editor
.DS_Store
.idea/
.vscode/
